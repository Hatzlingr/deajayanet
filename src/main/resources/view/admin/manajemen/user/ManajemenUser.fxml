<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<BorderPane styleClass="page-root" stylesheets="@manajemen-user-style.css" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1">
    <top>
        <VBox spacing="6.0" styleClass="page-header">
            <Label styleClass="page-title" text="Manajemen User" />
            <Label styleClass="page-subtitle" text="Kelola admin, kasir, dan member. Member memiliki remaining time." />
        </VBox>
    </top>

    <center>
        <ScrollPane fitToWidth="true" styleClass="content-scroll">
            <VBox prefWidth="800" spacing="18.0" styleClass="content-wrapper">
                <VBox spacing="14.0" styleClass="card">
                    <padding><Insets bottom="18" left="18" right="18" top="18" /></padding>
                    <HBox alignment="CENTER_LEFT">
                        <VBox HBox.hgrow="ALWAYS">
                            <Label fx:id="userFormTitleLabel" styleClass="section-title" text="Tambah User" />
                            <Label fx:id="userFormSubtitleLabel" styleClass="section-subtitle" text="Isi data lalu simpan." />
                        </VBox>
                        <Label fx:id="userEditModeBadge" styleClass="badge badge-info" text="CREATE" />
                    </HBox>
                    <VBox spacing="8.0">
                  <VBox spacing="8.0">
                     <children>
                        <Label styleClass="form-label" text="Username" />
                        <TextField fx:id="usernameField1" promptText="username" styleClass="form-input" />
                     </children>
                  </VBox>
                        <Label styleClass="form-label" text="Nama" />
                        <TextField fx:id="userNameField" promptText="Nama lengkap" styleClass="form-input" />
                    </VBox>
                    <VBox spacing="8.0">
                        <Label styleClass="form-label" text="Email" />
                        <TextField fx:id="usernameField" promptText="username" styleClass="form-input" />
                    </VBox>
               <VBox layoutX="29.0" layoutY="221.0" spacing="8.0">
                  <children>
                     <Label styleClass="form-label" text="Password" />
                     <TextField fx:id="usernameField2" promptText="username" styleClass="form-input" text="password" />
                  </children>
               </VBox>
                    <VBox spacing="8.0">
                        <Label styleClass="form-label" text="Type" />
                        <ComboBox fx:id="userRoleCombo" maxWidth="Infinity" promptText="Reguler/VIP" styleClass="form-combo" />
                    </VBox>
                    <VBox spacing="8.0">
                        <Label styleClass="form-label" text="Remaining Time Member" />
                        <TextField fx:id="remainingTimeField" promptText="0 menit" styleClass="form-input" />
                    </VBox>
                    <HBox spacing="8.0">
                        <Button fx:id="saveUserButton" maxWidth="Infinity" styleClass="primary-button" text="Simpan" HBox.hgrow="ALWAYS" />
                        <Button fx:id="cancelEditUserButton" managed="false" styleClass="secondary-button" text="Batal" visible="false" />
                    </HBox>
                </VBox>

                <VBox spacing="14.0" HBox.hgrow="ALWAYS">
                    <HBox alignment="CENTER_LEFT" spacing="10.0" styleClass="toolbar">
                        <TextField fx:id="searchUserField" promptText="Cari nama / username..." styleClass="search-field" HBox.hgrow="ALWAYS" />
                        <ComboBox fx:id="roleFilterCombo" prefWidth="160.0" promptText="Semua Tipe" styleClass="form-combo" />
                    </HBox>
                    <VBox fx:id="userRowContainer" spacing="12.0" />
                    <VBox fx:id="emptyUserState" alignment="CENTER" managed="false" spacing="8.0" styleClass="empty-state" visible="false">
                        <Label styleClass="empty-title" text="Belum ada user" />
                        <Label styleClass="empty-subtitle" text="Tambahkan user pertama lewat form di kiri." />
                    </VBox>
                </VBox>
            </VBox>
        </ScrollPane>
    </center>
</BorderPane>
