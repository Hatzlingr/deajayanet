<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<HBox alignment="CENTER_LEFT" spacing="14.0" styleClass="user-row card-flat" stylesheets="@manajemen-user-style.css" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1">
    <padding><Insets bottom="14" left="16" right="16" top="14" /></padding>
    <children>
        <VBox spacing="4.0" HBox.hgrow="ALWAYS">
            <HBox alignment="CENTER_LEFT" spacing="8.0">
                <Label fx:id="userNameLabel" styleClass="row-title" text="Topuria" />
                <Label fx:id="roleBadge" styleClass="badge badge-info" text="Reguler" />
            </HBox>
            <Label fx:id="usernameLabel" styleClass="row-subtitle" text="Amir" />
        </VBox>
        <VBox alignment="CENTER_RIGHT" prefWidth="150.0" spacing="3.0">
            <Label styleClass="form-label" text="Remaining" />
            <Label fx:id="remainingTimeLabel" styleClass="amount-text" text="120 menit" />
        </VBox>
        <HBox spacing="8.0">
            <Button fx:id="editUserButton" styleClass="secondary-button" text="Edit" />
            <Button fx:id="deleteUserButton" styleClass="danger-button" text="Delete" />
        </HBox>
    </children>
</HBox>
