<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<BorderPane fx:controller="com.deajayanet.features.admin.pesanan.PesananController"
            styleClass="page-root"
            stylesheets="@pesanan-style.css"
            xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1">
    <top>
        <VBox spacing="14.0" styleClass="page-header">
            <VBox spacing="4.0">
                <Label styleClass="page-title" text="Pusat Pesanan" />
                <Label styleClass="page-subtitle" text="Admin bisa input pesanan multi-item. Pesanan dari form ini otomatis lunas dan masuk antrian dapur." />
            </VBox>
        </VBox>
    </top>

    <center>
        <ScrollPane fitToWidth="true" styleClass="content-scroll">
            <VBox spacing="18.0" styleClass="content-wrapper">

                <VBox spacing="16.0" styleClass="form-card card">
                    <padding>
                        <Insets bottom="18" left="18" right="18" top="18" />
                    </padding>

                    <VBox spacing="4.0">
                        <Label styleClass="section-title" text="Tambah Pesanan Admin" />
                        <Label styleClass="section-subtitle" text="Gunakan form ini untuk pesanan yang dibayar langsung ke admin. Transaksi otomatis berstatus PAID." />
                    </VBox>

                    <HBox alignment="CENTER_LEFT" spacing="12.0">
                        <VBox spacing="6.0" HBox.hgrow="ALWAYS">
                            <Label styleClass="form-label" text="Sumber Pesanan" />
                            <ComboBox fx:id="computerCombo" maxWidth="Infinity" promptText="Pilih PC / Walk-in" styleClass="form-combo" />
                        </VBox>

                        <VBox spacing="6.0" HBox.hgrow="ALWAYS">
                            <Label styleClass="form-label" text="Menu" />
                            <ComboBox fx:id="menuCombo" maxWidth="Infinity" promptText="Pilih menu F&amp;B" styleClass="form-combo" />
                        </VBox>

                        <VBox spacing="6.0" prefWidth="110.0">
                            <Label styleClass="form-label" text="Qty" />
                            <TextField fx:id="quantityField" promptText="1" text="1" styleClass="form-input" />
                        </VBox>

                        <VBox alignment="BOTTOM_LEFT" spacing="6.0">
                            <Label styleClass="form-label" text=" " />
                            <Button fx:id="addItemButton" minWidth="120.0" styleClass="secondary-button" text="Tambah Item" />
                        </VBox>
                    </HBox>

                    <VBox spacing="10.0">
                        <HBox alignment="CENTER_LEFT" spacing="10.0">
                            <Label styleClass="section-subtitle" text="Draft Item Pesanan" />
                            <Region HBox.hgrow="ALWAYS" />
                            <Label styleClass="form-label" text="Total:" />
                            <Label fx:id="draftTotalLabel" styleClass="amount-text" text="Rp0" />
                        </HBox>

                        <VBox fx:id="draftItemContainer" spacing="8.0" styleClass="draft-list" />
                    </VBox>

                    <HBox alignment="CENTER_LEFT" spacing="10.0">
                        <Label fx:id="formMessageLabel" styleClass="message-success" text="Siap membuat pesanan baru." />
                        <Region HBox.hgrow="ALWAYS" />
                        <Button fx:id="clearDraftButton" styleClass="secondary-button" text="Reset Draft" />
                        <Button fx:id="saveOrderButton" styleClass="primary-button" text="Simpan Pesanan Lunas" />
                    </HBox>
                </VBox>

                <VBox spacing="14.0" styleClass="queue-section">
                    <HBox alignment="CENTER_LEFT" spacing="10.0">
                        <VBox spacing="4.0">
                            <Label styleClass="section-title" text="Daftar Pesanan Menunggu Antrian" />
                            <Label styleClass="section-subtitle" text="Yang tampil hanya pesanan lunas dengan status MENUNGGU atau DIPROSES. Status SELESAI otomatis hilang dari daftar." />
                        </VBox>
                        <Region HBox.hgrow="ALWAYS" />
                        <Label styleClass="badge badge-warning" text="Menunggu" />
                        <Label styleClass="badge badge-info" text="Diproses" />
                    </HBox>

                    <HBox alignment="CENTER_LEFT" spacing="10.0" styleClass="toolbar">
                        <TextField fx:id="searchOrderField" promptText="Cari nomor order / PC / user..." styleClass="search-field" HBox.hgrow="ALWAYS" />
                        <ComboBox fx:id="kitchenStatusFilterCombo" prefWidth="180.0" promptText="Semua Status" styleClass="form-combo" />
                        <Button fx:id="refreshOrderButton" styleClass="secondary-button" text="Refresh" />
                    </HBox>

                    <VBox fx:id="orderCardContainer" spacing="12.0" />

                    <VBox fx:id="emptyOrderState" alignment="CENTER" managed="false" spacing="8.0" styleClass="empty-state" visible="false">
                        <Label styleClass="empty-title" text="Belum ada pesanan menunggu" />
                        <Label styleClass="empty-subtitle" text="Pesanan lunas akan muncul setelah admin menyimpan pesanan atau pembayaran client sukses." />
                    </VBox>
                </VBox>
            </VBox>
        </ScrollPane>
    </center>
</BorderPane>
