<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<BorderPane styleClass="page-root"
            stylesheets="@pc-food.css"
            xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.deajayanet.features.pc.food.PcFoodController">

    <center>
        <HBox spacing="28" styleClass="page-content">
            <padding>
                <Insets top="28" right="64" bottom="44" left="64"/>
            </padding>

            <VBox spacing="22" HBox.hgrow="ALWAYS">
                <HBox alignment="CENTER_LEFT" spacing="16">
                    <Button text="←" onAction="#handleBack" styleClass="back-button"/>
                    <Label text="F&amp;B" styleClass="page-title"/>
                </HBox>

                <VBox styleClass="table-card" VBox.vgrow="ALWAYS">
                    <HBox alignment="CENTER_LEFT" spacing="20" styleClass="table-header">
                        <Label text="Menu" HBox.hgrow="ALWAYS" styleClass="table-header-text"/>
                        <Label text="Stok" prefWidth="120" styleClass="table-header-text"/>
                        <Label text="Harga" prefWidth="170" styleClass="table-header-text"/>
                        <Label text="Pesan" prefWidth="150" styleClass="table-header-text"/>
                    </HBox>

                    <ScrollPane fitToWidth="true" hbarPolicy="NEVER" styleClass="table-scroll" VBox.vgrow="ALWAYS">
                        <content>
                            <VBox fx:id="foodRowsContainer"/>
                        </content>
                    </ScrollPane>
                </VBox>

                <HBox alignment="CENTER_RIGHT" spacing="18">
                    <Label fx:id="totalLabel" text="0 Items | Rp 0" styleClass="total-label"/>
                    <Button text="Konfirmasi" onAction="#handleConfirm" styleClass="confirm-button"/>
                </HBox>
            </VBox>

            <VBox spacing="26" styleClass="side-panel" prefWidth="300">
                <StackPane styleClass="qr-box">
                    <Label fx:id="qrPlaceholderLabel" text="QR not ready yet" textAlignment="CENTER" styleClass="qr-text"/>
                </StackPane>
                <VBox spacing="12">
                    <Label text="Menunggu Verifikasi" styleClass="verify-title"/>
                    <Label fx:id="verifyTimerLabel" text="05:00" styleClass="verify-timer"/>
                </VBox>
                <Region VBox.vgrow="ALWAYS"/>
            </VBox>
        </HBox>
    </center>
</BorderPane>
