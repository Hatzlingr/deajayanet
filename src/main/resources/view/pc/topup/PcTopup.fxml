<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<BorderPane styleClass="page-root"
            stylesheets="@pc-topup.css"
            xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.deajayanet.features.pc.topup.PcTopupController">

    <center>
        <HBox spacing="28" styleClass="page-content">
            <padding>
                <Insets top="28" right="64" bottom="44" left="64"/>
            </padding>

            <VBox spacing="22" HBox.hgrow="ALWAYS">
                <HBox alignment="CENTER_LEFT" spacing="16">
                    <Button text="←" onAction="#handleBack" styleClass="back-button"/>
                    <Label text="Top Up" styleClass="page-title"/>
                </HBox>

                <VBox styleClass="table-card" VBox.vgrow="ALWAYS">
                    <HBox alignment="CENTER_LEFT" spacing="20" styleClass="table-header">
                        <Label text="Jenis Paket" prefWidth="140" styleClass="table-header-text"/>
                        <Label text="Paket" HBox.hgrow="ALWAYS" styleClass="table-header-text"/>
                        <Label text="Harga" prefWidth="180" styleClass="table-header-text"/>
                        <Label text="Konfirmasi" prefWidth="150" styleClass="table-header-text"/>
                    </HBox>

                    <ScrollPane fitToWidth="true" hbarPolicy="NEVER" styleClass="table-scroll" VBox.vgrow="ALWAYS">
                        <content>
                            <VBox fx:id="topupRowsContainer"/>
                        </content>
                    </ScrollPane>
                </VBox>
            </VBox>

            <VBox spacing="26" styleClass="side-panel" prefWidth="300">
                <StackPane styleClass="qr-box">
                    <Label fx:id="qrPlaceholderLabel" text="QR not ready yet" textAlignment="CENTER" styleClass="qr-text"/>
                </StackPane>
                <VBox spacing="12">
                    <Label text="Menunggu Verifikasi" styleClass="verify-title"/>
                    <Label fx:id="verifyTimerLabel" text="05:00" styleClass="verify-timer"/>
                    <Label fx:id="selectedPackageLabel" text="Belum ada paket dipilih" wrapText="true" styleClass="selected-package"/>
                </VBox>
                <Region VBox.vgrow="ALWAYS"/>
            </VBox>
        </HBox>
    </center>
</BorderPane>
