<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ProgressBar?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.shape.Circle?>

<BorderPane styleClass="page-root"
            stylesheets="@dashboard_user.css"
            xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="controller.DashboardController">

    <!-- ================= HEADER ================= -->

    <top>
        <HBox alignment="CENTER_LEFT"
              spacing="18"
              styleClass="top-navbar">

            <Label text="🖥" styleClass="logo-icon"/>
            <Label text="DeaJaya.Net" styleClass="logo-title"/>

            <Region HBox.hgrow="ALWAYS"/>

            <Circle radius="7" styleClass="status-dot"/>

            <Label text="Sesi aktif" styleClass="status-text"/>

            <Separator prefHeight="32" />

            <Label fx:id="miniTimerLabel"
                   text="00:00:00"
                   styleClass="mini-timer"/>
        </HBox>
    </top>

    <!-- ================= CONTENT ================= -->

    <center>
        <ScrollPane fitToWidth="true"
                    styleClass="content-scroll">

            <VBox spacing="20"
                styleClass="content-wrapper"
                maxWidth="Infinity">

                <!-- TOP INFO CARDS -->

                <GridPane hgap="18" vgap="18">

                    <columnConstraints>
                        <ColumnConstraints percentWidth="50"/>
                        <ColumnConstraints percentWidth="50"/>
                    </columnConstraints>

                    <!-- PC CARD -->

                    <HBox spacing="22"
                          alignment="CENTER_LEFT"
                          styleClass="info-card"
                          GridPane.columnIndex="0">

                        <padding>
                            <Insets top="26" right="28" bottom="26" left="28"/>
                        </padding>

                        <Label text="🖥️" styleClass="big-icon"/>

                        <VBox spacing="8">
                            <Label text="PC-01"
                                   styleClass="info-title"/>

                            <Label text="VIP"
                                   styleClass="vip-badge"/>
                        </VBox>
                    </HBox>

                    <!-- USER CARD -->

                    <HBox spacing="22"
                          alignment="CENTER_LEFT"
                          styleClass="info-card"
                          GridPane.columnIndex="1">

                        <padding>
                            <Insets top="26" right="28" bottom="26" left="28"/>
                        </padding>

                        <StackPane styleClass="avatar-circle">
                            <Label text="👤"
                                   styleClass="avatar-icon"/>
                        </StackPane>

                        <VBox spacing="6">

                            <Label text="Ahmad Rafhky"
                                   styleClass="info-title"/>

                            <HBox spacing="6">
                                <Label text="VIP Member"
                                       styleClass="member-label"/>

                                <Label text="👑"/>
                            </HBox>
                        </VBox>
                    </HBox>
                </GridPane>

                <!-- TIMER SECTION -->

                <VBox spacing="24"
                      alignment="CENTER"
                      styleClass="timer-card">

                    <padding>
                        <Insets top="55" right="40" bottom="55" left="40"/>
                    </padding>

                    <Label fx:id="timerLabel"
                           text="24:00:00"
                           styleClass="main-timer"/>

                    <Label text="Waktu tersisa"
                           styleClass="timer-subtitle"/>

                    <ProgressBar fx:id="progressBar"
                                 progress="0.5"
                                 maxWidth="Infinity"
                                 styleClass="timer-progress"/>
                </VBox>

                <!-- MENU -->

                <GridPane hgap="18" vgap="18">

                    <columnConstraints>
                        <ColumnConstraints percentWidth="25"/>
                        <ColumnConstraints percentWidth="25"/>
                        <ColumnConstraints percentWidth="25"/>
                        <ColumnConstraints percentWidth="25"/>
                    </columnConstraints>

                    <!-- F&B -->

                    <Button text="🍔  F&amp;B&#10;Pesan Makanan dan Minuman"
                            styleClass="menu-card"
                            GridPane.columnIndex="0"
                            prefHeight="150"
                            maxWidth="Infinity"/>

                    <!-- TOPUP -->

                    <Button text="➕  Top Up&#10;Tambah Durasi Billing"
                            styleClass="menu-card"
                            GridPane.columnIndex="1"
                            prefHeight="150"
                            maxWidth="Infinity"/>

                    <!-- HISTORY -->

                    <Button text="📋  Riwayat&#10;Transaksi dan Riwayat Sesi"
                            styleClass="menu-card"
                            GridPane.columnIndex="2"
                            prefHeight="150"
                            maxWidth="Infinity"/>

                    <!-- LOGOUT -->

                    <Button text="🚪  Log Out"
                            styleClass="menu-card logout-card"
                            GridPane.columnIndex="3"
                            prefHeight="150"
                            maxWidth="Infinity"/>
                </GridPane>

            </VBox>
        </ScrollPane>
    </center>
</BorderPane>