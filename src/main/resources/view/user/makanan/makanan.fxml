<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.shape.Circle?>

<BorderPane xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="controller.FoodPageController"
            stylesheets="@makanan.css"
            styleClass="page-root">

    <!-- ================= TOP NAVBAR ================= -->

    <top>
        <HBox alignment="CENTER_LEFT"
              spacing="16"
              styleClass="top-navbar">

            <padding>
                <Insets top="14" right="24" bottom="14" left="24"/>
            </padding>

            <Label text="🖥"
                   styleClass="logo-icon"/>

            <Label text="DeaJaya.Net"
                   styleClass="logo-title"/>

            <Region HBox.hgrow="ALWAYS"/>

            <Circle radius="6"
                    styleClass="status-dot"/>

            <Label text="Sesi aktif"
                   styleClass="status-label"/>

            <Separator orientation="VERTICAL"
                       prefHeight="28"/>

            <Label fx:id="sessionLabel"
                   text="00.00.00"
                   styleClass="session-time"/>
        </HBox>
    </top>

    <!-- ================= CONTENT ================= -->

    <center>

        <AnchorPane styleClass="content-wrapper">

            <!-- LEFT CONTENT -->

            <VBox spacing="20"
                  AnchorPane.topAnchor="26"
                  AnchorPane.leftAnchor="40"
                  AnchorPane.bottomAnchor="26"
                  AnchorPane.rightAnchor="360">

                <!-- HEADER -->

                <HBox alignment="CENTER_LEFT"
                      spacing="18">

                    <Button text="⟵"
                            styleClass="back-button"/>

                    <Label text="F&amp;B"
                           styleClass="page-title"/>
                </HBox>

                <!-- TABLE CARD -->

                <VBox VBox.vgrow="ALWAYS"
                      styleClass="table-card">

                    <!-- TABLE HEADER -->

                    <HBox styleClass="table-header">

                        <Label text="Menu"
                               HBox.hgrow="ALWAYS"
                               styleClass="table-header-text"/>

                        <Label text="Stok"
                               prefWidth="140"
                               styleClass="table-header-text"/>

                        <Label text="Harga"
                               prefWidth="220"
                               styleClass="table-header-text"/>

                        <Label text="Pesan"
                               prefWidth="180"
                               styleClass="table-header-text"/>
                    </HBox>

                    <!-- ROWS -->

                    <VBox fx:id="menuContainer"
                          spacing="0">

                        <!-- SAMPLE ROW -->

                        <HBox alignment="CENTER_LEFT"
                              styleClass="menu-row">

                            <Label text="Nasi Goreng"
                                   HBox.hgrow="ALWAYS"
                                   styleClass="menu-text"/>

                            <Label text="2"
                                   prefWidth="140"
                                   styleClass="menu-text"/>

                            <Label text="IDR 10000"
                                   prefWidth="220"
                                   styleClass="menu-text"/>

                            <HBox alignment="CENTER"
                                  spacing="10"
                                  prefWidth="180">

                                <Button text="−"
                                        styleClass="qty-button"/>

                                <Label text="0"
                                       styleClass="qty-text"/>

                                <Button text="+"
                                        styleClass="qty-button"/>
                            </HBox>
                        </HBox>

                    </VBox>

                </VBox>

                <!-- FOOTER -->

                <HBox alignment="CENTER_RIGHT"
                      spacing="18">

                    <Label fx:id="totalLabel"
                           text="0 Items | Rp 0"
                           styleClass="total-label"/>

                    <Button text="Konfirmasi"
                            styleClass="confirm-button"/>
                </HBox>

            </VBox>

            <!-- RIGHT PANEL -->

            <VBox spacing="24"
                  alignment="TOP_CENTER"
                  styleClass="right-panel"
                  AnchorPane.topAnchor="26"
                  AnchorPane.rightAnchor="40"
                  AnchorPane.bottomAnchor="26"
                  prefWidth="250">

                <!-- QR BOX -->

                <StackPane styleClass="qr-box">

                    <Label text="Qr not ready yet"
                           styleClass="qr-text"/>
                </StackPane>

                <!-- TIMER -->

                <VBox spacing="12"
                      alignment="CENTER_LEFT">

                    <Label text="Menunggu Verifikasi"
                           styleClass="verify-label"/>

                    <Label fx:id="verifyTimer"
                           text="05:00"
                           styleClass="verify-timer"/>
                </VBox>

            </VBox>

        </AnchorPane>

    </center>

</BorderPane>